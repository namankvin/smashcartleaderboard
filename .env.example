# Defaults to data/contacts.json in the project directory.
# CONTACTS_FILE=/absolute/path/to/contacts.json

# Required for durable queue, race state, laps and results.
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# MONGODB_DB_NAME=sk-leaderboard

# Optional server-to-server protection for RFID scans and tracker crossings.
# Also supply this to the tracker bridge process. Do not expose in browser code.
# INTEGRATION_TOKEN=replace-with-a-long-random-secret

# Required x-api-key for /api/arcade/scan and /api/rfid/scan.
# RFID_API_KEY=replace-with-the-key-shared-with-your-embedded-team

# Hosted deployments require MongoDB; Vercel enables this automatically.
# REQUIRE_MONGODB=true
# Per-worker connection pool limit (1-50, default 10).
# MONGODB_MAX_POOL_SIZE=10

# Hosted queue refreshes recover missed RC waiting-list registrations automatically.
# RC_REGISTRATION_SYNC=false
# For local testing only, enable with RC_REGISTRATION_SYNC=true.
